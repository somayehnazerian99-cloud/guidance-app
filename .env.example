# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
#
# `.env` is git-ignored. Never commit real credentials, and never put them in
# source code. In production set these in the hosting provider's environment
# variables (Netlify: Site configuration -> Environment variables) and, for CI,
# in GitHub Actions secrets.
# ---------------------------------------------------------------------------

# MongoDB connection string. Prisma requires a database name right after the
# host (Atlas omits it in its "Connect" dialog — add it by hand).
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/guidance?retryWrites=true&w=majority"

# Server-side signing key for password-reset tokens (HMAC-SHA256).
# Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="GENERATE_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"

# Public base URL, used for password-reset links, metadata and canonical URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Cloudinary — only needed for the homepage media manager
# (`/admin/homepage`, uploads of images, audio and video).
#
# If these are absent the rest of the app works normally and that one page
# shows: "اتصال فضای ذخیره‌سازی فایل هنوز تنظیم نشده است."
#
# The API secret is used exclusively on the server to sign upload and delete
# requests; it is never sent to the browser.
# Check the live status at GET /api/admin/diagnostics (admin only).
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

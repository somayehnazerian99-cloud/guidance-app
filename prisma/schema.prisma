generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  username      String    @unique
  password      String
  firstName     String
  lastName      String
  email         String?
  role          String    @default("STUDENT")
  isActive      Boolean   @default(true)
  approvalStatus String   @default("APPROVED")
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  studentProfile   StudentProfile?   @relation("UserStudentProfile")
  counselorProfile CounselorProfile? @relation("UserCounselorProfile")
  sessions         Session[]         @relation("UserSessions")
  auditLogs        AuditLog[]        @relation("UserAuditLogs")
  assignedStudents StudentProfile[]  @relation("CounselorStudents")
  assignedClasses  Class[]           @relation("CounselorClasses")
  supportTickets   SupportTicket[]   @relation("UserSupportTickets")
  supportReplies   SupportReply[]    @relation("UserSupportReplies")
  homeMedia        HomeMedia[]       @relation("HomeMediaCreator")

  @@index([role])
  @@index([email])
  @@index([role, approvalStatus])
}

model Session {
  id        String   @id @default(auto()) @map("_id")
  token     String   @unique
  userId    String   @db.ObjectId
  user      User     @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model School {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  city      String?
  province  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes  Class[]          @relation("SchoolClasses")
  students StudentProfile[] @relation("SchoolStudents")
}

model Class {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  grade       Int
  schoolYear  String
  schoolId    String   @db.ObjectId
  school      School   @relation("SchoolClasses", fields: [schoolId], references: [id])
  counselorId String?  @db.ObjectId
  counselor   User?    @relation("CounselorClasses", fields: [counselorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  students StudentProfile[] @relation("ClassStudents")

  @@index([schoolId])
  @@index([grade])
}

model StudentProfile {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @unique @db.ObjectId
  user            User     @relation("UserStudentProfile", fields: [userId], references: [id])
  studentCode     String   @unique
  schoolId        String?  @db.ObjectId
  school          School?  @relation("SchoolStudents", fields: [schoolId], references: [id])
  classId         String?  @db.ObjectId
  class           Class?   @relation("ClassStudents", fields: [classId], references: [id])
  counselorId     String?  @db.ObjectId
  counselor       User?    @relation("CounselorStudents", fields: [counselorId], references: [id])
  grade           Int
  schoolYear      String
  phone           String?
  address         String?
  parentPhone     String?
  profileComplete Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  grades          Grade[]           @relation("StudentGrades")
  interests       Interest[]        @relation("StudentInterests")
  abilities       Ability[]         @relation("StudentAbilities")
  testAttempts    TestAttempt[]     @relation("StudentAttempts")
  parentOpinions  ParentOpinion[]   @relation("StudentParentOpinions")
  guidanceResults GuidanceResult[]  @relation("StudentGuidanceResults")
  notifications   Notification[]    @relation("StudentNotifications")
}

model CounselorProfile {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  user      User     @relation("UserCounselorProfile", fields: [userId], references: [id])
  expertise String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Grade {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  studentId      String         @db.ObjectId
  student        StudentProfile @relation("StudentGrades", fields: [studentId], references: [id])
  subjectName    String
  score          Float
  maxScore       Float          @default(20)
  semester       Int
  academicYear   String
  gradeLevel     Int
  evaluationType String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([studentId])
}

model Interest {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  studentId String         @db.ObjectId
  student   StudentProfile @relation("StudentInterests", fields: [studentId], references: [id])
  category  String
  level     Int            @default(1)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([studentId])
}

model Ability {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  studentId String         @db.ObjectId
  student   StudentProfile @relation("StudentAbilities", fields: [studentId], references: [id])
  category  String
  score     Float          @default(0)
  level     String         @default("MEDIUM")
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([studentId])
}

model GuidanceTest {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  isActive    Boolean  @default(true)
  createdBy   String?  @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions Question[]    @relation("TestQuestions")
  attempts  TestAttempt[] @relation("TestAttempts")
}

model Question {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  testId    String       @db.ObjectId
  test      GuidanceTest @relation("TestQuestions", fields: [testId], references: [id])
  text      String
  order     Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  options Option[] @relation("QuestionOptions")

  @@index([testId])
}

model Option {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  questionId String   @db.ObjectId
  question   Question @relation("QuestionOptions", fields: [questionId], references: [id])
  text       String
  score      Float    @default(0)
  order      Int
  createdAt  DateTime @default(now())

  @@index([questionId])
}

model TestAttempt {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  studentId   String         @db.ObjectId
  student     StudentProfile @relation("StudentAttempts", fields: [studentId], references: [id])
  testId      String         @db.ObjectId
  test        GuidanceTest   @relation("TestAttempts", fields: [testId], references: [id])
  totalScore  Float          @default(0)
  completed   Boolean        @default(false)
  startedAt   DateTime       @default(now())
  completedAt DateTime?
  createdAt   DateTime       @default(now())

  answers TestAnswer[] @relation("AttemptAnswers")

  @@index([studentId])
  @@index([testId])
}

model TestAnswer {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  attemptId  String      @db.ObjectId
  attempt    TestAttempt @relation("AttemptAnswers", fields: [attemptId], references: [id])
  questionId String      @db.ObjectId
  optionId   String      @db.ObjectId
  score      Float       @default(0)
  createdAt  DateTime    @default(now())

  @@index([attemptId])
}

model ParentOpinion {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  studentId     String         @db.ObjectId
  student       StudentProfile @relation("StudentParentOpinions", fields: [studentId], references: [id])
  parentName    String?
  interests     String?
  abilities     String?
  fieldInterest String?
  behavioral    String?
  activities    String?
  generalNotes  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([studentId])
}

model GuidanceResult {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  studentId       String         @db.ObjectId
  student         StudentProfile @relation("StudentGuidanceResults", fields: [studentId], references: [id])
  suggestedFields String
  analysis        String?
  counselorNote   String?
  reviewedBy      String?        @db.ObjectId
  reviewedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([studentId])
}

model EducationalVideo {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  thumbnail   String?
  videoUrl    String
  category    String?
  isActive    Boolean  @default(true)
  createdBy   String?  @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model HomeMedia {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String?
  type         String   // IMAGE, AUDIO, VIDEO
  url          String
  publicId     String
  resourceType String   // image or video (Cloudinary uses video for audio)
  mimeType     String?
  bytes        Int?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdBy    String?  @db.ObjectId
  creator      User?    @relation("HomeMediaCreator", fields: [createdBy], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([type])
  @@index([isActive, sortOrder])
}

model Notification {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  studentId String         @db.ObjectId
  student   StudentProfile @relation("StudentNotifications", fields: [studentId], references: [id])
  title     String
  message   String
  isRead    Boolean        @default(false)
  type      String         @default("INFO")
  createdAt DateTime       @default(now())

  @@index([studentId])
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId
  user      User?    @relation("UserAuditLogs", fields: [userId], references: [id])
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([action])
}

model SupportTicket {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation("UserSupportTickets", fields: [userId], references: [id])
  subject   String
  category  String   @default("OTHER")
  priority  String   @default("NORMAL")
  status    String   @default("OPEN")
  closedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  replies SupportReply[] @relation("TicketReplies")

  @@index([userId])
  @@index([status])
}

model SupportReply {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  ticketId  String        @db.ObjectId
  ticket    SupportTicket @relation("TicketReplies", fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String        @db.ObjectId
  user      User          @relation("UserSupportReplies", fields: [userId], references: [id])
  body      String
  isStaff   Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([ticketId])
}

model PasswordResetToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}
